[run]
branch = True
include =
    scripts/infra/verify_role_sidecar_authorization.py

[report]
show_missing = True
skip_covered = False

[html]
directory = artifacts/pki-role-authorization-coverage/htmlcov

# No exclude_also rule is configured. The invariant-redundant
# `if len(path) > 1` guard was removed rather than hiding it from coverage.
