# Disabled until an operator deploys the TigerBeetle cluster and an encrypted
# service-mesh or mTLS TCP boundary. PostgreSQL remains the control-plane
# record; TigerBeetle holds only double-entry transfer facts.
UMOJA_TIGERBEETLE_ENABLED=false
# Decimal or 0x-prefixed unsigned 128-bit identifier; do not use the reserved testing ID 0.
UMOJA_TIGERBEETLE_CLUSTER_ID=
UMOJA_TIGERBEETLE_ADDRESSES=
UMOJA_TIGERBEETLE_NGN_LEDGER=
UMOJA_TIGERBEETLE_KES_LEDGER=
UMOJA_TIGERBEETLE_ZAR_LEDGER=
UMOJA_TIGERBEETLE_ACCOUNT_CODE=
UMOJA_TIGERBEETLE_TRANSFER_CODE=
UMOJA_TIGERBEETLE_TLS_REQUIRED=true
UMOJA_TIGERBEETLE_ALLOW_INSECURE_LOOPBACK=false
UMOJA_TIGERBEETLE_FAIL_CLOSED=true
