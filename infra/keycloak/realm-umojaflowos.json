{
  "realm": "umojaflowos",
  "enabled": true,
  "displayName": "UmojaFlowOS",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "quickLoginCheckMilliSeconds": 1000,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "maxDeltaTimeSeconds": 43200,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "accessTokenLifespanForImplicitFlow": 300,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "revokeRefreshToken": true,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA256",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "requiredActions": [
    { "alias": "CONFIGURE_TOTP", "name": "Configure OTP", "providerId": "CONFIGURE_TOTP", "enabled": true, "defaultAction": true, "priority": 10 }
  ],
  "roles": {
    "realm": [
      { "name": "umojaflowos_admin", "description": "UmojaFlowOS administrator" },
      { "name": "umojaflowos_compliance_officer", "description": "UmojaFlowOS compliance officer" },
      { "name": "umojaflowos_treasury_operator", "description": "UmojaFlowOS treasury operator" },
      { "name": "umojaflowos_auditor", "description": "UmojaFlowOS auditor" }
      ,{ "name": "provider_contact", "description": "Provider contact" }
      ,{ "name": "cbn_liaison", "description": "CBN liaison" }
      ,{ "name": "trade_sponsor", "description": "Trade sponsor" }
      ,{ "name": "procurement_owner", "description": "Procurement owner" }
      ,{ "name": "trade_finance_operator", "description": "Trade-finance operator" }
      ,{ "name": "supplier_representative", "description": "Supplier representative" }
      ,{ "name": "authorised_dealer_liaison", "description": "Authorised-dealer liaison" }
      ,{ "name": "reconciliation_reviewer", "description": "Reconciliation reviewer" }
    ]
  },
  "clients": [
    {
      "clientId": "umojaflowos-gateway",
      "name": "UmojaFlowOS gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "umojaflowos-admin-api",
      "name": "UmojaFlowOS admin API",
      "description": "Service-account client used only to create operator accounts from the console. Deliberately not the admin-cli superuser: it holds no realm-management rights beyond manage-users.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": []
    }
  ],
  "users": [
    {
      "username": "service-account-umojaflowos-admin-api",
      "enabled": true,
      "serviceAccountClientId": "umojaflowos-admin-api",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
