{
  "realm": "umojaflowos",
  "enabled": true,
  "displayName": "UmojaFlowOS",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "bruteForceProtected": true,
  "sslRequired": "external",
  "roles": {
    "realm": [
      { "name": "admin", "description": "UmojaFlowOS administrator" },
      { "name": "compliance_officer", "description": "UmojaFlowOS compliance officer" },
      { "name": "treasury_operator", "description": "UmojaFlowOS treasury operator" },
      { "name": "auditor", "description": "UmojaFlowOS auditor" }
    ]
  },
  "clients": [
    {
      "clientId": "umojaflowos-gateway",
      "name": "UmojaFlowOS gateway",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [],
      "webOrigins": [],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "use.refresh.tokens": "true"
      },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
