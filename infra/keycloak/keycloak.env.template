# Disabled until the organisation has approved a Keycloak realm and client.
# The issuer and audience are public identity metadata. This verifier uses a
# JWKS bearer-token flow, so it accepts no browser-held client secret.
UMOJA_KEYCLOAK_ENABLED=false
UMOJA_KEYCLOAK_ISSUER=
UMOJA_KEYCLOAK_AUDIENCE=
UMOJA_KEYCLOAK_TLS_REQUIRED=true
UMOJA_KEYCLOAK_FAIL_CLOSED=true
