{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 0, "y": 0},
      "id": 1,
      "title": "Signer Attempts and Retries",
      "type": "timeseries",
      "targets": [
        {"expr": "rate(umoja_signer_attempts_total[5m])", "legendFormat": "attempts/s", "refId": "A"},
        {"expr": "rate(umoja_signer_retries_total[5m])", "legendFormat": "retries/s", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "color": {"mode": "thresholds", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 20}]}}}, "overrides": []},
      "gridPos": {"h": 7, "w": 12, "x": 12, "y": 0},
      "id": 2,
      "title": "Signer Retry Ratio",
      "type": "timeseries",
      "targets": [{"expr": "100 * rate(umoja_signer_retries_total[5m]) / clamp_min(rate(umoja_signer_attempts_total[5m]), 0.001)", "legendFormat": "retry ratio", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 7},
      "id": 3,
      "title": "Retry Exhaustion",
      "type": "stat",
      "targets": [{"expr": "sum(umoja_signer_retry_exhausted_total)", "legendFormat": "exhausted", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "thresholds", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 3}]}}, "decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 7},
      "id": 4,
      "title": "Non-Retryable Signer Failures",
      "type": "stat",
      "targets": [{"expr": "sum(umoja_signer_non_retryable_errors_total)", "legendFormat": "non-retryable", "refId": "A"}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms", "color": {"mode": "palette-classic"}}, "overrides": []},
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 7},
      "id": 5,
      "title": "Payment Submission Latency",
      "type": "timeseries",
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(umoja_payment_submission_duration_seconds_bucket[5m]))) * 1000", "legendFormat": "p95", "refId": "A"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(umoja_payment_submission_duration_seconds_bucket[5m]))) * 1000", "legendFormat": "p99", "refId": "B"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}, "decimals": 0}, "overrides": []},
      "gridPos": {"h": 6, "w": 12, "x": 0, "y": 13},
      "id": 6,
      "title": "Signer Counter Totals",
      "type": "table",
      "targets": [
        {"expr": "umoja_signer_attempts_total", "legendFormat": "attempts", "refId": "A", "instant": true, "format": "table"},
        {"expr": "umoja_signer_retries_total", "legendFormat": "retries", "refId": "B", "instant": true, "format": "table"},
        {"expr": "umoja_signer_retry_exhausted_total", "legendFormat": "exhausted", "refId": "C", "instant": true, "format": "table"},
        {"expr": "umoja_signer_non_retryable_errors_total", "legendFormat": "non-retryable", "refId": "D", "instant": true, "format": "table"}
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["umoja", "mojaloop", "signer", "payments"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timepicker": {},
  "timezone": "utc",
  "title": "UmojaFlowOS — Mojaloop Signer Observability",
  "uid": "umoja-mojaloop-signer",
