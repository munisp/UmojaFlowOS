{
  "title": "Umoja Keycloak Evidence Publisher Compliance",
  "schemaVersion": 39,
  "version": 1,
  "timezone": "utc",
  "tags": ["umoja", "keycloak", "evidence", "security"],
  "templating": {"list": []},
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Compliance Monitor",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "umoja_keycloak_token_monitor_up{client_id=\"umoja-evidence-publisher\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"}
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Observed Token TTL (seconds)",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "umoja_keycloak_token_ttl_seconds{client_id=\"umoja-evidence-publisher\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 300, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 60}, {"color": "red", "value": 301}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "showThresholdLabels": true, "showThresholdMarkers": true}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token Compliance Failures",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [{"expr": "increase(umoja_keycloak_token_monitor_failures_total{client_id=\"umoja-evidence-publisher\"}[10m])", "refId": "A", "legendFormat": "failures"}],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "single"}}
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rotation and Rollback Events",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [
        {"expr": "increase(umoja_keycloak_rotation_failures_total[10m])", "refId": "A", "legendFormat": "rotation failures"},
        {"expr": "increase(umoja_keycloak_rotation_rollback_failures_total[10m])", "refId": "B", "legendFormat": "rollback failures"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi"}}
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Revocation Canary Enabled",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 13},
      "targets": [{"expr": "umoja_keycloak_token_revocation_check{client_id=\"umoja-evidence-publisher\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"min": 0, "max": 1, "thresholds": {"steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}}, "overrides": []},
      "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "colorMode": "background", "graphMode": "none", "justifyMode": "auto"}
    }
  ]
}
