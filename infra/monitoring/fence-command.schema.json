{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://umoja.example.invalid/schemas/fence-command.schema.json",
  "title": "Umoja Settlement Fence Command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "command_id",
    "action",
    "reason",
    "environment",
    "source_alerts",
    "issued_at",
    "expires_at",
    "nonce",
    "signer",
    "signature"
  ],
  "properties": {
    "command_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$"},
    "action": {"type": "string", "enum": ["FENCE", "OPEN"]},
    "reason": {"type": "string", "minLength": 1, "maxLength": 512},
    "environment": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"},
    "source_alerts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"}
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "nonce": {"type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$"},
    "signer": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{3,128}$"},
    "signature": {"type": "string", "contentEncoding": "base64", "minLength": 88, "maxLength": 88}
  }
}
