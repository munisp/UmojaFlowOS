# Disabled until a private Ollama runtime is provisioned, verified, and approved.
# Verification is performed by scripts/document-intelligence/verify_private_ollama.py,
# which must exit zero before this is enabled.
OLLAMA_ENABLED=false

# Private or internal hostname only. Public hosts are refused by the adapter.
OLLAMA_BASE_URL=https://ollama.svc.internal:11434
OLLAMA_TLS_REQUIRED=true
OLLAMA_TLS_CA_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE

# Authentication control for any non-loopback endpoint. Supply mTLS client
# credentials or a bearer credential; the adapter refuses to run without one.
OLLAMA_MTLS_CERT_SECRET_REF=
OLLAMA_MTLS_KEY_SECRET_REF=
OLLAMA_AUTH_TOKEN_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE

# Exact pinned tags. A ":latest" tag is refused because it cannot be attributed.
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_ALLOWED_VISION_MODELS=qwen3-vl:8b
OLLAMA_TEXT_FALLBACK_MODEL=deepseek-r1:8b

# Digest allowlist. Evidence is only accepted from these exact weights.
OLLAMA_ALLOWED_MODEL_DIGESTS=901cae73216286ea8c5aba8b46d307ff7188f737285ec500c795a12f05225d28,6995872bfe4c521a67b32da386cd21d5c6e819b6e0d62f79f64ec83be99f5763

# Bounded inputs and timeouts so a slow or oversized request cannot stall review.
OLLAMA_TIMEOUT_SECONDS=45
OLLAMA_MAX_IMAGE_BYTES=8388608

# The analysis boundary fails closed: if the runtime is unreachable, drifted, or
# unauthenticated, the workflow records unavailable evidence and produces no
# verification decision. It never assumes a pass.
OLLAMA_FAIL_CLOSED=true
OLLAMA_EVIDENCE_ONLY=true
