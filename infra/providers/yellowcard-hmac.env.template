# Yellow Card provider boundary — safe to commit and disabled by default.
#
# This template holds only non-secret configuration and names of deployment
# secrets. The runtime composition layer must resolve a *_SECRET_REFERENCE from
# the approved secret manager in memory; it must never store, log, or return the
# resolved API key, HMAC secret, or webhook secret.
#
# An enabled adapter can request and validate RFQs only. It does not authorise
# wallet creation, asset movement, settlement, or a payment-order state change.

UMOJA_YELLOWCARD_ENABLED=false
UMOJA_YELLOWCARD_ENVIRONMENT=sandbox

# A credential-free HTTPS base URL. Production must not use localhost, an IP
# literal, URL userinfo, a query string, or a URL fragment.
UMOJA_YELLOWCARD_BASE_URL=
UMOJA_YELLOWCARD_TLS_REQUIRED=true
UMOJA_YELLOWCARD_ALLOW_INSECURE_LOOPBACK=false

# Secret-manager object names, not secret values.
UMOJA_YELLOWCARD_API_KEY_SECRET_REFERENCE=REPLACE_WITH_SECRET_REFERENCE
UMOJA_YELLOWCARD_HMAC_SECRET_REFERENCE=REPLACE_WITH_SECRET_REFERENCE
UMOJA_YELLOWCARD_WEBHOOK_SECRET_REFERENCE=REPLACE_WITH_SECRET_REFERENCE
# Rotation overlap only: remove this reference after the provider retry horizon.
UMOJA_YELLOWCARD_WEBHOOK_PREVIOUS_SECRET_REFERENCE=
# The replay Redis password is a distinct managed secret.
UMOJA_YELLOWCARD_REPLAY_REDIS_PASSWORD_SECRET_REFERENCE=REPLACE_WITH_SECRET_REFERENCE
# The approved secret injector mount is non-secret deployment metadata.
UMOJA_YELLOWCARD_MATERIAL_MOUNT_PATH=

# Activation requires a provider-specific, non-mutating authenticated probe.
# The generic Bearer health probe is not valid for this HMAC-authenticated API.
UMOJA_YELLOWCARD_READINESS_PATH=/health
UMOJA_YELLOWCARD_READINESS_TIMEOUT_MS=8000
UMOJA_YELLOWCARD_REQUIRE_SANDBOX_CERTIFICATION=true
UMOJA_YELLOWCARD_REQUIRE_PRODUCTION_IP_ALLOWLIST=true
UMOJA_YELLOWCARD_FAIL_CLOSED=true

# RFQ policy. This is an allowlist, not a provider authorisation.
UMOJA_YELLOWCARD_ALLOWED_SOURCE_ASSETS=USDC,USDT
UMOJA_YELLOWCARD_ALLOWED_CORRIDORS=NGN,KES,ZAR
UMOJA_YELLOWCARD_MAX_RFQ_AMOUNT_REFERENCE=REPLACE_WITH_APPROVED_LIMIT_REFERENCE

# Inbound webhook boundary. The public URL is set only after the gateway route,
# TLS certificate, and provider allowlist are approved.
UMOJA_YELLOWCARD_WEBHOOK_ENABLED=false
UMOJA_YELLOWCARD_WEBHOOK_PUBLIC_URL=
UMOJA_YELLOWCARD_WEBHOOK_ALLOWED_CIDRS_REFERENCE=REPLACE_WITH_APPROVED_CIDR_REFERENCE
# Resolved, comma-separated provider source prefixes consumed by the receiver.
# Never use a catch-all prefix such as 0.0.0.0/0 or ::/0.
UMOJA_YELLOWCARD_WEBHOOK_ALLOWED_CIDRS=
UMOJA_YELLOWCARD_WEBHOOK_SIGNATURE_HEADER=X-YC-Signature
UMOJA_YELLOWCARD_WEBHOOK_TIMESTAMP_HEADER=X-YC-Timestamp
UMOJA_YELLOWCARD_WEBHOOK_MAX_AGE_SECONDS=300
UMOJA_YELLOWCARD_WEBHOOK_REPLAY_STORE_REFERENCE=REPLACE_WITH_REDIS_NAMESPACE_REFERENCE
UMOJA_YELLOWCARD_REPLAY_REDIS_ADDRESS=redis:6379
UMOJA_YELLOWCARD_REPLAY_KEY_PREFIX=yellowcard:webhook:
UMOJA_YELLOWCARD_WEBHOOK_EVIDENCE_DIRECTORY=/var/lib/umojaflowos/webhook-evidence
UMOJA_YELLOWCARD_WEBHOOK_RECONCILIATION_QUEUE_DIRECTORY=/var/lib/umojaflowos/webhook-reconciliation
UMOJA_YELLOWCARD_WEBHOOK_BODY_MAX_BYTES=262144
UMOJA_YELLOWCARD_WEBHOOK_TLS_REQUIRED=true
UMOJA_YELLOWCARD_WEBHOOK_FAIL_CLOSED=true

# Webhook acceptance records only verified, minimal lifecycle evidence. It may
# not set a payment or payment-leg execution/finality state without independent
# provider-reference verification and PostgreSQL/TigerBeetle reconciliation.
UMOJA_YELLOWCARD_WEBHOOK_CAN_SETTLE=false

# The receiver verifies Base64(HMAC-SHA-256(raw request body)); timestamp freshness,
# CIDR membership, bounded-body handling and Redis SET NX replay protection are all
# mandatory. Confirm the provider's documented signing canonicalization before enablement.
