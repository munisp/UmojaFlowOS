<group name="umoja,sod,">
  <rule id="100810" level="12">
    <decoded_as>json</decoded_as>
    <field name="event">sod_monitor_evaluation</field>
    <field name="evaluationState">exceptions_detected</field>
    <field name="exceptionDigest">^[a-f0-9]{64}$</field>
    <description>UmojaFlowOS segregation-of-duties exception detected</description>
    <options>alert_by_email</options>
    <group>compliance,sod_exception,</group>
  </rule>

  <rule id="100811" level="12">
    <decoded_as>json</decoded_as>
    <field name="event">sod_monitor_indeterminate</field>
    <description>UmojaFlowOS segregation-of-duties monitor is indeterminate</description>
    <options>alert_by_email</options>
    <group>compliance,sod_monitor_failure,</group>
  </rule>

  <rule id="100812" level="10">
    <decoded_as>json</decoded_as>
    <field name="event">sod_alert_delivery</field>
    <field name="deliveryState">unavailable</field>
    <field name="exceptionDigest">^[a-f0-9]{64}$</field>
    <description>UmojaFlowOS segregation-of-duties notification delivery unavailable</description>
    <group>compliance,sod_alert_delivery_failure,</group>
  </rule>

  <rule id="100820" level="12">
    <if_group>syscheck</if_group>
    <field name="syscheck.path">^/var/log/umoja/sod-audit\.jsonl$</field>
    <description>UmojaFlowOS SoD JSONL audit log changed or tampered</description>
    <options>alert_by_email</options>
    <group>compliance,sod_audit_tamper,</group>
  </rule>
</group>
