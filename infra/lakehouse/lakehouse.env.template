# Disabled until an approved S3-compatible lakehouse is available.
UMOJA_LAKEHOUSE_ENABLED=false
UMOJA_LAKEHOUSE_ENDPOINT=
UMOJA_LAKEHOUSE_BUCKET=
UMOJA_LAKEHOUSE_REGION=us-east-1
UMOJA_LAKEHOUSE_ACCESS_KEY_ID_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
UMOJA_LAKEHOUSE_SECRET_ACCESS_KEY_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
UMOJA_LAKEHOUSE_ENCRYPTION_KEY_REFERENCE=
UMOJA_LAKEHOUSE_RETENTION_POLICY_REFERENCE=
UMOJA_LAKEHOUSE_TLS_REQUIRED=true
UMOJA_LAKEHOUSE_FAIL_CLOSED=true

# --- ML lakehouse wiring (services/ml-intelligence) -------------------------
# Local bronze/silver/gold parquet root for dev/CI and continuous-training
# snapshots. In governed deployments this is the mount point of the
# S3-compatible volume configured above. The ML lakehouse refuses to open
# when UMOJA_LAKEHOUSE_ENABLED=false (fail-closed, matching the boundary).
UMOJA_LAKEHOUSE_ROOT=infra/lakehouse/data
