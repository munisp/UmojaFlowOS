# Disabled until a private, mTLS-protected Temporal namespace is approved.
# The Go payment engine validates every value below before a worker may start;
# a blank or placeholder value keeps the workflow boundary closed.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=temporal.internal.example:7233
TEMPORAL_NAMESPACE=umojaflowos-payments
TEMPORAL_TASK_QUEUE=umojaflowos-payment-orchestration
TEMPORAL_TLS_REQUIRED=true
TEMPORAL_CA_CERT_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
TEMPORAL_CLIENT_CERT_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
TEMPORAL_CLIENT_KEY_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
# Provider activities remain separately gated: an enabled worker does not by
# itself authorise any outbound payment instruction.
TEMPORAL_PROVIDER_ACTIVITIES_ENABLED=false
