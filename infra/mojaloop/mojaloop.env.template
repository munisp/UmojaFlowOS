# Disabled until a licensed scheme participant issues an FSPIOP endpoint and
# an HSM/key-management signing reference. The Go adapter never accepts a
# private signing key in its own configuration.
MOJALOOP_FSPIOP_ENABLED=false
MOJALOOP_FSPIOP_BASE_URL=
MOJALOOP_FSPIOP_SOURCE_FSP=
MOJALOOP_FSPIOP_SIGNER_REFERENCE=
MOJALOOP_FSPIOP_TLS_REQUIRED=true
MOJALOOP_FSPIOP_FAIL_CLOSED=true
