# Disabled until a licensed scheme participant issues an FSPIOP endpoint and
# an HSM/key-management signing reference. The Go adapter never accepts a
# private signing key in its own configuration.
MOJALOOP_FSPIOP_ENABLED=false
MOJALOOP_FSPIOP_BASE_URL=
MOJALOOP_FSPIOP_SOURCE_FSP=
MOJALOOP_FSPIOP_SIGNER_REFERENCE=
MOJALOOP_FSPIOP_TLS_REQUIRED=true
MOJALOOP_FSPIOP_FAIL_CLOSED=true

# Bounded delegated-signer retry policy. MaxAttempts includes the initial call.
MOJALOOP_FSPIOP_SIGNER_MAX_ATTEMPTS=3
MOJALOOP_FSPIOP_SIGNER_INITIAL_BACKOFF=25ms
MOJALOOP_FSPIOP_SIGNER_MAX_BACKOFF=250ms
# Retry only transient timeout/temporary failures; never retry cancellation,
# authorization, malformed-request, or empty-signature errors.
MOJALOOP_FSPIOP_SIGNER_RETRY_TRANSIENT_ONLY=true
