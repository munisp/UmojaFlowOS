# Disabled until APISIX is deployed with the official open-appsec attachment
# plus an appsec agent in prevention mode. open-appsec is not an APISIX route
# plugin; the attachment/agent pair inspects ingress traffic before upstream.
UMOJA_OPENAPPSEC_ENABLED=false
UMOJA_OPENAPPSEC_DEPLOYMENT_MODE=attachment_agent
UMOJA_OPENAPPSEC_POLICY_BUNDLE_REFERENCE=
UMOJA_OPENAPPSEC_AGENT_TOKEN_SECRET_REF=REPLACE_WITH_SECRET_REFERENCE
UMOJA_OPENAPPSEC_APISIX_ATTACHMENT_REQUIRED=true
UMOJA_OPENAPPSEC_PREVENTION_REQUIRED=true
UMOJA_OPENAPPSEC_FAIL_CLOSED=true
